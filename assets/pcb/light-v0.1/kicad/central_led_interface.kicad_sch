  (text "SIX ZONES / ONE LOCKING FLEX CONNECTION"
    (at 20.32 15.24 0)
    (effects
      (font
        (size 2.0 2.0))
      (justify left top))
    (uuid "ebc5fbdd-fc6a-5c7e-8ce7-370aa7b24fb5"))
  (text "J2 mates directly to upper LED flex J100.\n30 contacts carry 24 independent electrical nets.\nFused positive rails remain separate for every zone."
    (at 20.32 25.4 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left top))
    (uuid "990f7fec-3fa9-5b7e-9aea-2c1ef40adc51"))
  (text "PIN BLOCKS: 4 / 5 / 6 / 1 / 2 / 3\nWithin each block: +24 V, +24 V, W, N, C\nDuplicate positive contacts connect ONLY within that zone.\nNo common ground contact; these are switched LED returns."
    (at 116.84 53.34 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left top))
    (uuid "38d20c94-4151-5d3d-a19c-685ae2ff98a8"))
  (text "MATING: Molex 2005280300, bottom contact / Front Flip.\nUpper-flex contacts are B.Cu; reinforcement is FRONT.\nNative flex front view, tip up: pin 1 LEFT.\nLooking directly at gold, tip up: pin 1 RIGHT.\nGold faces main PCB when inserted.\nMate only with power disconnected; provide strain relief."
    (at 116.84 91.44 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left top))
    (uuid "6672af84-bd22-54e8-bebf-70b246919758"))
  (text "Finished insertion thickness 0.30 +/-0.05 mm, all layers included.\nFingers: gold >=0.1 um over nickel 1-5 um; no solder coating.\nTail dimensional and stack acceptance required from fabricator.\nSee MATING-TAIL-CONTRACT.json and fabrication drawing."
    (at 116.84 134.62 0)
    (effects
      (font
        (size 1.0 1.0))
      (justify left top))
    (uuid "87dcaeb6-dcf5-56b0-be9f-b7f1f527f670")))
